# ============================================================
#  Soundscape — Frontend environment variables
#  Copie para `.env` (local) ou configure no dashboard da Square Cloud.
#  ATENCAO: tudo com prefixo VITE_ vai para o bundle publico.
#  NUNCA coloque client secret ou chave de IA aqui.
# ============================================================

# URL base da API (backend)
# Local:     http://127.0.0.1:3333
# Producao:  https://soundscape-api.squareweb.app
VITE_API_URL=http://127.0.0.1:3333

# URL de callback do OAuth do Spotify (deve ser identica a registrada
# no Spotify Developer Dashboard e a SPOTIFY_REDIRECT_URI do backend)
# Local:     http://127.0.0.1:5173/callback
# Producao:  https://soundscape.squareweb.app/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
