{
  "name": "soundscape-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Soundscape — perfil musical inteligente com Spotify + IA",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "1.7.7",
    "framer-motion": "11.11.11",
    "html2canvas": "1.4.1",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "recharts": "2.13.3",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.7.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
