# ============================================================
#  Soundscape — Backend environment variables
#  Copie este arquivo para `.env` (local) ou configure cada
#  variavel no dashboard da Square Cloud (nunca commite .env).
# ============================================================

# ---------- Servidor ----------
# Ambiente de execucao: development | production
NODE_ENV=development
# Porta HTTP. Na Square Cloud a porta e injetada automaticamente.
PORT=3333

# ---------- Spotify (https://developer.spotify.com/dashboard) ----------
# Client ID do app criado no Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
# Client Secret — NUNCA exponha no frontend
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# URL de callback do FRONTEND, registrada em "Redirect URIs" no dashboard do Spotify
# Local:      http://127.0.0.1:5173/callback
# Producao:   https://soundscape.squareweb.app/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# ---------- IA ----------
# Provider da IA: openai | openrouter | groq | custom
AI_PROVIDER=openai
# Chave da API de IA
AI_API_KEY=your_ai_api_key
# Modelo usado para gerar o perfil musical
AI_MODEL=gpt-4o
# Base URL da API (troque se usar OpenRouter/Groq/compativel)
AI_BASE_URL=https://api.openai.com/v1
# Timeout em ms para a chamada de IA
AI_TIMEOUT_MS=90000

# ---------- Sessoes ----------
# String aleatoria longa usada para assinar os session tokens
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque_por_uma_string_aleatoria_bem_longa
# Tempo de vida da sessao em horas
SESSION_TTL_HOURS=12

# ---------- CORS ----------
# URL do frontend (origem permitida). Aceita lista separada por virgula.
# Local:     http://127.0.0.1:5173,http://localhost:5173
# Producao:  https://soundscape.squareweb.app
FRONTEND_URL=http://127.0.0.1:5173

# ---------- Rate limit ----------
# Janela em minutos e maximo de requisicoes por IP na janela
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# Limite especifico para as rotas de IA (mais caras)
RATE_LIMIT_AI_MAX=20

# ---------- Logs ----------
# debug | info | warn | error
LOG_LEVEL=info
